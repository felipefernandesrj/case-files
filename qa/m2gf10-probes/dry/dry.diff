     verdict.appendChild(paper);
   }
   if (correct) {
+    const arrest = document.createElement('div');
+    arrest.className = 'arrest';
+    if (lastAccuseResult.ccShown) arrest.classList.add('is-static');
+    lastAccuseResult.ccShown = true;
     const stamp = document.createElement('div');
     stamp.className = 'case-closed-stamp';
     stamp.setAttribute('aria-hidden', 'true');
     stamp.textContent = lang === 'pt' ? 'CASO ENCERRADO' : 'CASE CLOSED';
-    verdict.appendChild(stamp);
